{
  "name": "daily-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:recall": "pnpm --filter @daily-signal/ai benchmark:recall",
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:server && pnpm test:storybook",
    "test:server": "turbo run test:server",
    "test:storybook": "turbo run test:storybook",
    "test:storybook:watch": "turbo run test:storybook:watch",
    "storybook": "turbo run storybook --",
    "build-storybook": "turbo run build-storybook",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint --deny-warnings scripts",
    "lint:fix": "turbo run lint:fix && oxlint --fix scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "format:server": "oxfmt packages/config packages/api packages/ai packages/database packages/feeds packages/network packages/providers packages/settings apps/web/server",
    "format:server:check": "oxfmt --check packages/config packages/api packages/ai packages/database packages/feeds packages/network packages/providers packages/settings apps/web/server",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "desktop:prepare": "pnpm build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "node --test scripts/desktop-smoke.test.mjs"
  },
  "devDependencies": {
    "@daily-signal/database": "workspace:*",
    "@tauri-apps/cli": "^2.11.5",
    "esbuild": "^0.25.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "node-gyp": "^13.0.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "turbo": "^2.11.4"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
