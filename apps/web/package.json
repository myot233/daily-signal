{
  "name": "@daily-signal/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix .",
    "dev": "tsx watch --include \"../../packages/*/src/**/*.ts\" server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:watch": "vitest --project=storybook",
    "test": "pnpm test:storybook"
  },
  "dependencies": {
    "@daily-signal/ai": "workspace:*",
    "@daily-signal/api": "workspace:*",
    "@daily-signal/client": "workspace:*",
    "@daily-signal/config": "workspace:*",
    "@daily-signal/database": "workspace:*",
    "@daily-signal/domain": "workspace:*",
    "@daily-signal/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "es-toolkit": "^1.52.0",
    "express": "^5.1.0",
    "jotai": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@daily-signal/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
